# Settings the site reads. The values live in Vercel (Project → Settings → Environment Variables),
# never in git. .env.local stays on your own machine for local runs only.

# Google Analytics 4 measurement ID. Read at build time: add it before the deploy, or redeploy after.
NEXT_PUBLIC_GA_ID=G-TWVXMFMR2Y

# Make webhook the /contact form posts to (scenario "CDA Immersive Contact Webhook").
# Without it the form falls back to opening the visitor's email app.
CONTACT_WEBHOOK_URL=

# Optional. Search Console is verified by DNS, so this stays empty.
GOOGLE_SITE_VERIFICATION=
